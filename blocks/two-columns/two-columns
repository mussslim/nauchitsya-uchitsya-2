.two-columns { display: flex; justify-content: space-between; gap: 40px; width: 80%; margin: 100px auto; }
.two-columns__brief { flex: 0 0 175px; margin: 0; color: #2f80ed; font-size: 18px; line-height: 1.2; font-weight: 400; }
.two-columns__main-text { width: 80%; max-width: 784px; }
.two-columns__paragraph { margin: 0 0 30px; font-size: 24px; line-height: 1.42; font-weight: 400; }
.two-columns__paragraph:last-child { margin-bottom: 0; }
.two-columns__span-accent { font-weight: 700; }
@media (max-width: 700px) { .two-columns { flex-direction: column; width: auto; margin: 64px 24px; gap: 24px; } .two-columns__main-text { width: 100%; } .two-columns__paragraph { font-size: 18px; } }
